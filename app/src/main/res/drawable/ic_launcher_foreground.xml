<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A banknote losing a coin, tilted for a playful neo-brutalist tone. Kept within the
         66dp adaptive-icon safe zone so it survives circle/squircle/rounded-square masks. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-8">
        <!-- hard shadow, offset the same way HardShadowBox draws its shadow -->
        <path
            android:fillColor="#000000"
            android:pathData="M33,43 L85,43 L85,77 L33,77 Z" />
        <!-- banknote -->
        <path
            android:fillColor="#FFF5E6"
            android:strokeColor="#000000"
            android:strokeWidth="5"
            android:pathData="M28,38 L80,38 L80,72 L28,72 Z" />
        <!-- coin -->
        <path
            android:fillColor="#FF0080"
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:pathData="M66,55 A12,12 0 1,1 42,55 A12,12 0 1,1 66,55 Z" />
        <!-- coin detail ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="2.5"
            android:pathData="M60,55 A6,6 0 1,1 48,55 A6,6 0 1,1 60,55 Z" />
    </group>
</vector>
